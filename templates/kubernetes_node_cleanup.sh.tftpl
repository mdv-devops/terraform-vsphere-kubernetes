#!/usr/bin/env bash
set -euo pipefail
umask 077

LOG_FILE="$PWD/kubernetes-node-cleanup.log"
exec > >(tee "$LOG_FILE") 2>&1

EXPECTED_NODES="${expected_nodes}"
TALOS_ENDPOINT="${endpoint}"

TEMP_DIR="$(mktemp -d)"
trap 'rm -rf "$TEMP_DIR"' EXIT

printf '%s' "$KUBECONFIG_CONTENT" > "$TEMP_DIR/kubeconfig"
printf '%s' "$TALOSCONFIG_CONTENT" > "$TEMP_DIR/talosconfig"
chmod 600 "$TEMP_DIR/kubeconfig" "$TEMP_DIR/talosconfig"

export KUBECONFIG="$TEMP_DIR/kubeconfig"
export TALOSCONFIG="$TEMP_DIR/talosconfig"

unset KUBECONFIG_CONTENT TALOSCONFIG_CONTENT

echo "=== Kubernetes Node Cleanup ==="

kubectl --kubeconfig "$KUBECONFIG" cluster-info >/dev/null

# Collect etcd membership.
ETCD_MEMBERS="$(talosctl --talosconfig "$TALOSCONFIG" --endpoints "$TALOS_ENDPOINT" --nodes "$TALOS_ENDPOINT" etcd members)"

kubectl --kubeconfig "$KUBECONFIG" get nodes -o jsonpath='{range .items[*]}{.metadata.name}{" "}{.status.addresses[?(@.type=="InternalIP")].address}{" "}{.status.conditions[?(@.type=="Ready")].status}{"\n"}{end}' |
while read -r name ip ready; do
  [[ -n "$name" && -n "$ip" ]] || continue

  # Never delete expected nodes.
  for expected in $EXPECTED_NODES; do
    if [[ "$ip" == "$expected" ]]; then
      echo "KEEP: $name ($ip)"
      continue 2
    fi
  done

  # Fail closed for unexpected healthy nodes.
  if [[ "$ready" != "False" && "$ready" != "Unknown" ]]; then
    echo "ERROR: Unexpected node $name ($ip) is not confirmed NotReady" >&2
    exit 1
  fi

  # Do not delete a node still listed in etcd.
  if printf '%s\n' "$ETCD_MEMBERS" | grep -Fq "https://$ip:2380"; then
    echo "ERROR: $name ($ip) is still an etcd member" >&2
    exit 1
  fi

  # A responsive Talos API means the node may still be active.
  if talosctl --talosconfig "$TALOSCONFIG" --endpoints "$TALOS_ENDPOINT" --nodes "$ip" version >/dev/null 2>&1; then
    echo "ERROR: Talos API still responds on $ip" >&2
    exit 1
  fi

  echo "DELETE: $name ($ip)"
  kubectl --kubeconfig "$KUBECONFIG" delete node "$name" --ignore-not-found=true --wait=true --timeout=2m
done

echo "SUCCESS: Kubernetes Node cleanup completed"